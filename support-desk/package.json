{
  "name": "support-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Step-by-step AI support desk sample for 3flows Intelligence",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "yarn build && node --test --test-concurrency=1 dist/steps/*/*.test.js",
    "step:01": "yarn build && node dist/steps/01-intelligent-service/main.js",
    "step:02": "yarn build && node dist/steps/02-anatomy-of-a-call/main.js",
    "step:03": "yarn build && node dist/steps/03-prompts-as-configuration/main.js",
    "step:04": "yarn build && node dist/steps/04-swap-and-test/main.js",
    "step:04:local": "yarn build && node dist/steps/04-swap-and-test/main.local.js",
    "step:05": "yarn build && node dist/steps/05-choose/main.js",
    "step:06": "yarn build && node dist/steps/06-judge/main.js",
    "step:07": "yarn build && node dist/steps/07-extract/main.js",
    "step:08": "yarn build && node dist/steps/08-meaning-and-action/main.js",
    "step:09": "yarn build && node dist/steps/09-remember/main.js",
    "step:10": "yarn build && node dist/steps/10-stream/main.js",
    "step:11": "yarn build && node dist/steps/11-act/main.js",
    "step:12": "yarn build && node dist/steps/12-documents-as-context/main.js",
    "step:13": "yarn build && node dist/steps/13-embeddings/main.js",
    "step:14": "yarn build && node dist/steps/14-rag/main.js",
    "step:15": "yarn build && node dist/steps/15-rerank/main.js",
    "step:16": "yarn build && node dist/steps/16-measure/main.js",
    "step:17": "yarn build && node dist/steps/17-improve-with-evidence/main.js",
    "step:18": "yarn build && node dist/steps/18-judge-the-answers/main.js",
    "step:19": "yarn build && node dist/steps/19-guard-the-input/main.js",
    "step:20": "yarn build && node dist/steps/20-guard-the-output/main.js",
    "step:21": "yarn build && node dist/steps/21-humans-in-the-loop/main.js",
    "step:22": "yarn build && node dist/steps/22-model-per-job/main.js",
    "step:23": "yarn build && node dist/steps/23-dont-block/main.js",
    "step:24": "yarn build && node dist/steps/24-see-what-it-did/main.js",
    "step:25": "yarn build && node dist/steps/25-going-live/main.js",
    "eval:16": "yarn build && node dist/steps/16-measure/eval.js",
    "eval:17": "yarn build && BASELINE=steps/16-measure/evals/report.json node dist/steps/17-improve-with-evidence/eval.js",
    "eval:18": "yarn build && node dist/steps/18-judge-the-answers/eval.js",
    "eval:22": "yarn build && BASELINE=steps/17-improve-with-evidence/evals/report.json node dist/steps/22-model-per-job/eval.js"
  },
  "dependencies": {
    "@3flows/intelligence": "next",
    "@3flows/platform": "next"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.18.0"
}
